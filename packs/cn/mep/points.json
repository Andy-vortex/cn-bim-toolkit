{
 "_说明": "水电点位规则，见同目录 README。sources：依据（条文号 + 自拟概括 + 参数 + 可信度 A/B/C/—；条文都来自网页转载，待原文核对；惯例没有条文依据）。points：点位类型（符号、类别、缺省高度 z、回路前缀）。circuits：回路前缀（max 是每路上限，weight 是各点位类型占几个名额）。furniture：家具组（furniture.json 的键，键:部件 指到水槽、灶台、台盆）。rooms：房间类型（room_types.json）→ 规则，min 是这类房间至少几个插座。checks：校验门槛（工具自己的，不是规范值）；点位位置只按实物定，和出图比例无关。高度都是底边离本层楼面，毫米。",
 "sources": {
  "S1": {"ref": "GB 55038-2025 第 7.4.3 条第 1 款", "summary": "插座回路设剩余电流保护", "params": {"rcd_ma": 30}, "level": "A", "status": "待原文核对"},
  "S2": {"ref": "GB 55038-2025 第 7.4.3 条第 2 款", "summary": "户配电箱底边高度：单排不低于 1.8m，双排不低于 1.6m", "params": {"single_row_min": 1800, "double_row_min": 1600}, "level": "A", "status": "待原文核对"},
  "S3": {"ref": "GB 55038-2025 第 7.4.4 条", "summary": "照明、空调插座、2kW 以上设备、厨房插座、其他插座分别设回路", "params": {}, "level": "A", "status": "待原文核对"},
  "S4": {"ref": "GB 55038-2025 第 7.4.5 条", "summary": "插座用安全型；卫生间插座防溅；洗衣机、冰箱、油烟机、排风机、热水器、空调处各设一个专用三孔插座", "params": {}, "level": "A", "status": "待原文核对"},
  "S5": {"ref": "GB 55038-2025 表 7.4.5", "summary": "各房间最少插座数：起居室 3、卧室 2、厨房 3（不含电炉用）、卫生间 1", "params": {"living": 3, "bedroom": 2, "kitchen": 3, "bathroom": 1}, "level": "B", "status": "待原文核对"},
  "S6": {"ref": "GB 55038-2025 第 7.4.7 条", "summary": "有固定浴盆或淋浴的卫生间做局部等电位联结", "params": {}, "level": "A", "status": "待原文核对"},
  "S7": {"ref": "JGJ 242-2011 第 8.5.4 条", "summary": "插座底边高度：空调挂机、油烟机等不低于 1.8m，洗衣机 1.0～1.3m，柜机、冰箱、一般插座 0.3～0.5m；起居室、卧室、书房的插座宜分设在不同墙面", "params": {"high_min": 1800, "washer": [1000, 1300], "low": [300, 500]}, "level": "A", "status": "待原文核对"},
  "S8": {"ref": "JGJ 242-2011 第 6 章（条文号未查到）", "summary": "每一路插座回路的插座不超过 10 个（组）", "params": {"max_per_circuit": 10}, "level": "B", "status": "待原文核对"},
  "S9": {"ref": "GB 50303-2015 第 20.2.3 条", "summary": "开关边缘距门框边缘", "params": {"gap": [150, 200]}, "level": "B", "status": "待原文核对"},
  "S10": {"ref": "GB 50617-2010 第 5.2.4 条", "summary": "设计无要求时开关面板底边高度", "params": {"z": [1300, 1400]}, "level": "B", "status": "待原文核对"},
  "C1": {"ref": "惯例", "summary": "床头开关、插座离地 0.7～0.75m，在床两侧离床边约 150", "params": {"z": [700, 750], "gap": 150}, "level": "C", "status": "惯例"},
  "C2": {"ref": "惯例", "summary": "厨房台面插座离地 1.1～1.2m（台面以上约 0.3m）", "params": {"z": [1100, 1200]}, "level": "C", "status": "惯例"},
  "C3": {"ref": "惯例", "summary": "空调挂机插座离地 2.0～2.2m，柜机 0.3m", "params": {"wall": [2000, 2200], "floor": 300}, "level": "B", "status": "惯例"},
  "C4": {"ref": "惯例", "summary": "油烟机插座离地 2.0～2.2m，在灶台中线正上方", "params": {"z": [2000, 2200]}, "level": "C", "status": "惯例"},
  "C5": {"ref": "惯例", "summary": "冰箱插座常做到 1.3～1.5m，便于插拔", "params": {"z": [1300, 1500]}, "level": "C", "status": "惯例"},
  "C6": {"ref": "惯例", "summary": "洗衣机插座离地 1.2～1.3m", "params": {"z": [1200, 1300]}, "level": "B", "status": "惯例"},
  "C7": {"ref": "惯例", "summary": "弱电箱（信息配线箱）底边 0.3～0.5m，在玄关或客厅", "params": {"z": [300, 500]}, "level": "C", "status": "惯例"},
  "C8": {"ref": "惯例", "summary": "电视墙：电视插座、网络插座和 2～3 个五孔插座，壁挂电视离地 1.0～1.1m；每间卧室、书房一个网络插座", "params": {"z": [1000, 1100]}, "level": "C", "status": "惯例"},
  "C9": {"ref": "惯例", "summary": "淋浴混水阀：冷热水口中心距 150，离地 1.0～1.2m", "params": {"z": [1000, 1200], "spacing": 150}, "level": "C", "status": "惯例"},
  "C10": {"ref": "惯例", "summary": "台盆、厨房水槽：冷热水口离地 0.45～0.55m，间距 150～200", "params": {"z": [450, 550], "spacing": [150, 200]}, "level": "C", "status": "惯例"},
  "C11": {"ref": "惯例", "summary": "坐便：给水口离地 0.2～0.3m、偏离中心 200～250；排水坑距 300 或 400（离完成墙面）", "params": {"z": [200, 300], "offset": [200, 250], "pit": [300, 400]}, "level": "C", "status": "惯例"},
  "C12": {"ref": "惯例", "summary": "洗衣机给水龙头离地 1.0～1.2m，排水进旁边的地漏", "params": {"z": [1000, 1200]}, "level": "C", "status": "惯例"},
  "C13": {"ref": "惯例", "summary": "浴缸龙头、混水口离地 0.6～0.75m", "params": {"z": [600, 750]}, "level": "C", "status": "惯例"},
  "C14": {"ref": "惯例", "summary": "地漏在淋浴区角落、离墙不小于 100；洗衣机旁单独一个", "params": {"from_wall_min": 100}, "level": "C", "status": "惯例"},
  "C15": {"ref": "惯例", "summary": "面对墙，热水在左、冷水在右", "params": {}, "level": "B", "status": "惯例"},
  "C16": {"ref": "推断", "summary": "卫生间插座离淋浴区边不小于 0.6m（按 IEC 60364-7-701 的分区推断，原文没查）", "params": {"clear": 600}, "level": "—", "status": "推断"},
  "C17": {"ref": "惯例", "summary": "空调插座回路：柜机每台一路，挂机两台一路", "params": {}, "level": "C", "status": "惯例"},
  "C18": {"ref": "推断", "summary": "局部等电位端子箱的高度没查到，暂按一般插座 0.3m 放", "params": {"z": 300}, "level": "—", "status": "推断"},
  "C19": {"ref": "推断", "summary": "卫生间插座高度没查到，沿用符号库防溅插座的缺省高度 1.5m", "params": {"z": 1500}, "level": "—", "status": "推断"},
  "C20": {"ref": "惯例", "summary": "台盆、厨房水槽的排水口在台盆、水槽正下方的柜内，离墙 0.1～0.2m", "params": {"from_wall": [100, 200]}, "level": "C", "status": "惯例"},
  "S11": {"ref": "GB 50034-2013 第 7.2 节（条文号未查到）", "summary": "每一照明单相分支回路电流不宜超过 16A，所接光源数或 LED 灯具数不宜超过 25 个", "params": {"max_per_circuit": 25}, "level": "B", "status": "待原文核对"},
  "C21": {"ref": "惯例", "summary": "筒灯沿吊顶边带的中线均布，间距 1.0～1.5m，离墙、离转角留出一段", "params": {"spacing": [1000, 1500]}, "level": "C", "status": "惯例"},
  "C22": {"ref": "推断", "summary": "回字形灯槽里暗藏灯带，沿灯槽走一圈，按米计", "params": {}, "level": "—", "status": "推断"},
  "C23": {"ref": "推断", "summary": "一间房的灯分组控制（主灯、筒灯、灯带各一组），同一个门口的各组合在一块多联面板上（有双控的组时用多联双控面板）；86 型面板常见到三联，多了挨着再加一个面板", "params": {"panel_max": 3}, "level": "—", "status": "推断"},
  "C24": {"ref": "惯例", "summary": "筒灯之间中心距不小于 0.8m：一段放不下两盏的只放一盏在正中，窄过道里两排挨得太近的只放一排在中线上；一排里的间距取整到 10mm，余数分给两头", "params": {"spacing_min": 800, "round": 10}, "level": "C", "status": "惯例"},
  "C25": {"ref": "推断", "summary": "灯具定位图上，同一直线上相邻两盏筒灯相距超过最大间距的 1.5 倍就不算一排，分开标注，各自量到最近的那面墙", "params": {"row_break": 1.5}, "level": "—", "status": "推断"},
  "C26": {"ref": "推断", "summary": "一排筒灯两头到墙只差一点（不到 0.1m）时取对称；同一圈里相对的两排可布灯长度相差不到一个间距时两排灯位对齐（取短的那排的排法），现场按房间对称排，差一点看着像画错", "params": {"end_sym_max": 100, "align_within": 1.0}, "level": "—", "status": "推断"}
 },
